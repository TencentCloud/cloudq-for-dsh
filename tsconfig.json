{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js", "scripts/**/*.mjs", "tests/**/*.ts", "tsdown.config.ts"]
}
