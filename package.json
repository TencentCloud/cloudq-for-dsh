{
  "name": "dsh-cloudq",
  "version": "0.2.0",
  "description": "CloudQ integration for DeepSeek Harness with secure credential, workspace, and plugin-management surfaces",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "assets/cloudq.png",
    "skills/cloudq/SKILL.md",
    "skills/cloudq/scripts/*.py",
    "skills/cloudq/references/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "author": "Tencent Cloud",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cloudq",
    "tencent-cloud",
    "aiops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TencentCloud/cloudq-for-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/TencentCloud/cloudq-for-dsh/issues"
  },
  "homepage": "https://github.com/TencentCloud/cloudq-for-dsh#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsdown && node scripts/copy-types.mjs",
    "check:client": "node scripts/check-client-bundle.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:python": "python3 -m unittest discover -s skills/cloudq/tests -p 'test_*.py'",
    "test:all": "pnpm run test && pnpm run test:python",
    "secret-scan": "node scripts/secret-scan.mjs",
    "prepare": "pnpm run build && pnpm run check:client",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test:all",
    "prepack": "pnpm run test:contract && pnpm run secret-scan"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "eslint": "^10.0.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
